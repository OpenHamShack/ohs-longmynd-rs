+    /* A PicoTuner reading the NIM's TS one bit wide says so with bcdDevice 0x0102 (0x0101 is */
+    /* parallel, like the FTDI); the demodulator must then be told to send serial TS          */
+    if (err==ERROR_NONE) {
+        struct libusb_device_descriptor opened;
+        if (libusb_get_device_descriptor(libusb_get_device(*usb_device_handle_ptr), &opened)==0)
+            stv0910_serialTS = (opened.idVendor==altvid) && (opened.idProduct==altpid) && (opened.bcdDevice==0x0102);
